<mujoco model="aesir_complete_flat_tower">
  <!-- "flat" track + actuated button tower + loose buttons in ONE physics world
       for the base+arm mission (rl_ws/fsm_training/mission_env.py).

       - The tower pose is set by the env at runtime (on top of the platform,
         z = PLATFORM_SURFACE_Z); the pos in torre_botones.xml is not used here.
       - The loose buttons are only here because BotonArmEnv needs them to
         initialize; the env parks them.
       - The freeze_base weld starts INACTIVE so the base can drive. BotonArmEnv
         anchors it to the real chassis pose when PRESS_BUTTON starts, and the
         env releases it afterwards. -->
  <compiler angle="radian" autolimits="true" meshdir=""/>
  <option timestep="0.002" iterations="50" tolerance="1e-10" cone="elliptic"/>
  <size njmax="1000" nconmax="500" nstack="2000000"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
    <map znear="0.01" zfar="50"/>
  </visual>

  <include file="aesir_mujoco_robot.xml"/>
  <include file="plataform.xml"/>
  <include file="torre_botones.xml"/>
  <include file="botones_sueltos.xml"/>

  <equality>
    <weld name="freeze_base" body1="footprint_link" active="false"
          solref="0.0002 1" solimp="0.9999 0.9999 1e-6"/>
  </equality>
</mujoco>
