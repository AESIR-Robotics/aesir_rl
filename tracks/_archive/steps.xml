    <texture name="texplane" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 0.15 0.2" width="512" height="512"/>
    <material name="matplane" reflectance="0.3" texture="texplane" texrepeat="4 4" texuniform="true"/>
    <material name="steps_visual" rgba="0.5 0.5 0.55 1"/>
    <material name="obs_hub" rgba="0.8 0.3 0.15 1"/>
    <material name="obs_door" rgba="0.2 0.6 0.85 1"/>

    <mesh name="base_link_mesh" file="meshes/steps/base_link.stl" scale="0.001 0.001 0.001"/>
    <mesh name="hub_1" file="meshes/steps/Component3_1.stl" scale="0.001 0.001 0.001"/>
    <mesh name="hub_2" file="meshes/steps/Component3_2.stl" scale="0.001 0.001 0.001"/>
