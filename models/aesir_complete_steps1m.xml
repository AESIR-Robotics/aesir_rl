<mujoco model="aesir_complete_steps1m">

  <!-- GENERADO: robot + pista "steps1m" (campo de escalones de 1x1 m) para el
       entrenamiento multi-pista. Mismo compiler/option/visual que
       aesir_complete_steps.xml (RADIANES). -->
  <compiler angle="radian" autolimits="true" meshdir=""/>
  <option timestep="0.002" iterations="50" tolerance="1e-10" cone="elliptic"/>
  <size njmax="1000" nconmax="500" nstack="2000000"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
    <map znear="0.01" zfar="50"/>
  </visual>

  <include file="aesir_mujoco_robot.xml"/>
  <include file="track_steps1m.xml"/>
</mujoco>
